# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# scratch dir for one-off scripts (beta credentials, ad-hoc exports, …)
# Never commit anything from here — it's local-only by convention.
/tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (only commit .env.example)
# Catch-all: ignore every .env* variant (.env, .env.local,
# .env.production.local, .env.local.aws, etc.) except the public template.
.env*
!.env.example
!.env.staging.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# drizzle generated migrations metadata
/drizzle/meta

# editor
.vscode/
.idea/

# pnpm local store
/.pnpm-store/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/e2e/.storage-state.json
*.local

# local file storage (uploads)
data/uploads/*
!data/uploads/.gitkeep

# Cursor IDE
.cursor/
agent-transcripts/

# Internal cleanup docs (not for public repo)
docs/internet-cleanup-checklist.md
