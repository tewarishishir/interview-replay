# ─────────────────────────────────────────────────────────────────────────────
# InterviewReplay — Self-Hosted Environment Variables
# Copy this file to `.env.local` and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (local dev or self-hosted Postgres)
DATABASE_URL="postgres://ir:ir@localhost:5432/ir"

# Auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Your app's public URL
NEXTAUTH_URL="http://localhost:3000"

# ── Local File Storage ─────────────────────────────────────────────────────────
# Directory for uploaded files (audio, resumes, exports).
# Defaults to ./data/uploads when not set.
# STORAGE_PATH="./data/uploads"

# Secret for signing file-access tokens. Generate with: openssl rand -base64 32
STORAGE_SECRET="replace-me-with-a-32-byte-random-string"

# ── Optional: Google OAuth ────────────────────────────────────────────────────

# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── Optional: Email via SMTP (falls back to console logging) ──────────────────

# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@example.com"

# ── Optional: LLM backend for analysis ───────────────────────────────────────

# Option A: Ollama (local, free — default)
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL_LARGE="llama3.3:70b"
# LLM_MODEL_SMALL="llama3.3:8b"

# Option B: Any OpenAI-compatible API
# OLLAMA_BASE_URL="https://api.openai.com/v1"
# LLM_API_KEY="sk-..."

# ── Optional: Proxy configuration ────────────────────────────────────────────
# TRUSTED_PROXY_HOPS="1"

# ── Optional: Closed beta mode ───────────────────────────────────────────────
# INVITE_ONLY_BETA="false"
