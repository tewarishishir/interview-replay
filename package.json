{
  "name": "interview-replay",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "InterviewReplay — interview coaching tool that records candidate microphone during real interviews and provides AI-generated feedback.",
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "DRIZZLE_COMMAND=push drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx --conditions=react-server src/scripts/check-db-schema.ts",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local src/scripts/seed.ts",
    "admin:promote": "tsx --conditions=react-server --env-file=.env.local src/scripts/promote-admin.ts",
    "seed:beta": "tsx --conditions=react-server --env-file=.env.local src/scripts/seed-beta-users.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.44.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "jsonrepair": "^3.14.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "next": "^15.5.15",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^7.0.3",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.5",
    "react-hook-form": "^7.75.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.15",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0 <25"
  }
}
